# Copy to .env.local at the repository root, edit, then source it before launch.
# The app reads exported variables; it does not automatically load this file.
export LLAMA_STACK_URL=https://ogx.apps.cluster.example.com
export INFERENCE_MODEL=vllm-inference/gpt-4.1
export MCP_TOOL_MODEL=vllm-inference/gpt-4.1
export EMBEDDING_MODEL=openai/text-embedding-3-small
export EMBEDDING_DIMENSION=1536
export VECTOR_DB_PROVIDER_ID=faiss

# Choose the protocol explicitly: llama_guard (default) or gpt.
# Use a registered model compatible with the chosen protocol.
# An empty value does not disable guardrails.
export GUARDRAIL_MODE=llama_guard
export GUARDRAIL_MODEL=ollama/llama-guard3:8b

# For a GPT classifier through the same OGX server, use these instead:
# export GUARDRAIL_MODE=gpt
# export GUARDRAIL_MODEL=openai/gpt-4.1-mini

# Optional, for private repositories or GitHub rate limits:
# export GITHUB_TOKEN=your-token
# For tool calls, this URL must be reachable from OGX, not just from your laptop:
# export MCP_SERVER_URL=https://mcp.example.com/mcp
